# Secrets - never commit
.env
.streamlit/secrets.toml

# Data caches
data/raw/*
!data/raw/.gitkeep
data/clean/*
!data/clean/.gitkeep
data/analytics/*
!data/analytics/.gitkeep
data/results/*
!data/results/.gitkeep
fixtures/*.csv

# Deployment seed — the exception to the rules above.
# Every page is read-only over these artifacts (no page recomputes the pipeline
# at load time), so a fresh clone or a hosted deploy has nothing to render
# without them: the dashboard comes up on empty-state placeholders. They are
# produced by `python -X utf8 tests/fixtures.py` followed by
# `python -X utf8 -m src.pipeline`, and the synthetic fixture set needs no
# network. Regenerate them rather than hand-editing.
!data/raw/*.csv
!data/clean/bhavcopy.parquet
!data/clean/rejections.csv
!data/analytics/*.parquet
!data/results/*/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Logs
*.log

# Photo originals (re-downloadable with tools/build_photos.py)
tools/_photo_sources/

# Local render/probe scratch (not part of the shipped project)
.probe/
.probe_hero/
.probe_fresh.py
/screenshots/
