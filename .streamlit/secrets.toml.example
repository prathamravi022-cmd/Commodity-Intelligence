# Sign-in configuration — copy this file to .streamlit/secrets.toml and fill it in.
#
# While this file does not exist (or the [auth] block is absent from
# .streamlit/secrets.toml) the application runs as a public research prototype.
# Adding a complete [auth] block switches the sign-in gate on for every page.
# Nothing else in the project needs to change, and reverting is deleting the
# block.
#
# Never commit .streamlit/secrets.toml. The real values belong in the host's
# secret store, not in the repository.

[auth]
# The OIDC provider's discovery document. For Clerk:
# Dashboard → Configure → SSO connections / OIDC → copy the discovery URL,
# shaped like:
#   https://<your-instance>.clerk.accounts.dev/.well-known/openid-configuration
server_metadata_url = "https://<your-instance>.clerk.accounts.dev/.well-known/openid-configuration"

# The OIDC client credentials issued by that provider. The client secret is
# read by Streamlit on the server and is never sent to, or stored in, the
# browser.
client_id = "<oidc-client-id>"
client_secret = "<oidc-client-secret>"

# Where the provider sends the browser back. Streamlit appends
# "/oauth2callback" to the application origin, so these are the exact values to
# register as allowed redirect URIs on the provider:
#   local development  http://localhost:8601/oauth2callback
#   production         https://<your-domain>/oauth2callback
# A different port, scheme or trailing slash is a different URI and will fail.
redirect_uri = "http://localhost:8601/oauth2callback"

# Signs the session cookie. Generate your own; it is not a provider value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "<a-long-random-string-you-generate>"
